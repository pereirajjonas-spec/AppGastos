# ============================================================
#  DESPESAS DE VIAGEM — Grupo MSA
#  Copie para .env e preencha.
# ============================================================

PORT=3100
# Endereço público do app (vai nos links de e-mail). Sem barra no final.
APP_URL=http://localhost:3100

# Segredo da sessão: no mínimo 32 caracteres aleatórios. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
SESSAO_DIAS=30
# Teto de leituras de nota por IA por usuário a cada 24 h (0 = sem teto; administrador não tem teto)
LIMITE_LEITURAS_DIA=50
# true quando o app estiver publicado em HTTPS
COOKIE_SECURE=false
# true se estiver atrás de proxy reverso (IIS/nginx)
TRUST_PROXY=

# Domínios de e-mail aceitos no cadastro (vazio = qualquer)
EMAIL_DOMINIOS=grupomsa.com.br

# --- Leitura das notas (Claude) ---
ANTHROPIC_API_KEY=
# Em uso: claude-sonnet-5-5 (recomendado). claude-opus-5-5 é o mais preciso e custa mais.
# claude-haiku-4-5 funciona, mas nos testes errou mais em foto/PDF escaneado (chave, CNPJ, data, categoria).
ANTHROPIC_MODEL=claude-opus-5-5

# Provedor de IA principal: anthropic | kimi  (o admin também pode trocar na tela Usuários)
IA_PROVEDOR=kimi
# --- Kimi (Moonshot) ---
MOONSHOT_API_KEY=
KIMI_MODEL=kimi-k3

# --- DeepSeek (em avaliação; só usado se escolhido, nunca como alternativa automática) ---
# API direta da DeepSeek (platform.deepseek.com). Modelo padrão: deepseek-flash
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_THINKING=off   # desliga o raciocínio: mais rápido e barato, mas errou mais em foto ruim (não recomendado)

# --- E-mail (redefinição de senha e convites) ---
# Office 365: smtp.office365.com / 587 / SMTP_SECURE=false (conta precisa de SMTP AUTH liberado)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Despesas de Viagem <nao-responda@grupomsa.com.br>"

# Local do banco (opcional). Ele guarda tudo, inclusive as fotos/PDFs das notas.
# DB_PATH=D:\app-gastos\data\gastos.db

# Primeiro administrador criado no start, se ainda não houver nenhum (útil em hospedagem sem terminal)
#ADMIN_EMAIL=
#ADMIN_NOME=
#ADMIN_SENHA=
